rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "Yg0zdHJLOBW9LwTBxzAUopww6kA2"; // ADMIN_UID
    }

    function hasValidPostShape(data) {
      return data.keys().hasAll([
          "title",
          "slug",
          "excerpt",
          "content",
          "coverImage",
          "coverImagePath",
          "tags",
          "status",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ])
        && data.keys().hasOnly([
          "title",
          "slug",
          "excerpt",
          "content",
          "coverImage",
          "coverImagePath",
          "tags",
          "status",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.slug is string
        && data.slug.size() > 0
        && data.slug.size() <= 120
        && data.slug.matches("^[^/]+$")
        && data.excerpt is string
        && data.excerpt.size() <= 500
        && data.content is string
        && data.content.size() <= 300000
        && (data.coverImage == null
          || (data.coverImage is string && data.coverImage.size() <= 2048))
        && (data.coverImagePath == null
          || (data.coverImagePath is string && data.coverImagePath.size() <= 512))
        && data.tags is list
        && data.tags.size() <= 20
        && data.status in ["draft", "published"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.publishedAt == null || data.publishedAt is timestamp);
    }

    function hasValidCreateTimes(data) {
      return data.createdAt == request.time
        && data.updatedAt == request.time
        && ((data.status == "draft" && data.publishedAt == null)
          || (data.status == "published" && data.publishedAt == request.time));
    }

    function hasValidUpdateTimes(before, after) {
      return after.createdAt == before.createdAt
        && after.updatedAt == request.time
        && ((after.status == "draft" && after.publishedAt == null)
          || (after.status == "published"
            && ((before.status == "published" && after.publishedAt == before.publishedAt)
              || (before.status == "draft" && after.publishedAt == request.time))));
    }

    function slugPointsToPost(postId, slug) {
      return getAfter(/databases/$(database)/documents/postSlugs/$(slug)).data.postId == postId;
    }

    function validSlugReservation(slug, data) {
      return data.keys().hasAll(["postId", "createdAt", "updatedAt"])
        && data.keys().hasOnly(["postId", "createdAt", "updatedAt"])
        && data.postId is string
        && data.postId.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && getAfter(/databases/$(database)/documents/posts/$(data.postId)).data.slug == slug;
    }

    function hasValidSiteContentShape(locale, data) {
      return locale in ["zh", "en", "ja"]
        && data.keys().hasAll([
          "locale",
          "heroKicker",
          "heroName",
          "heroIntro",
          "aboutTitle",
          "aboutParagraphs",
          "contactTitle",
          "contactNote",
          "contactEmail",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "locale",
          "heroKicker",
          "heroName",
          "heroIntro",
          "aboutTitle",
          "aboutParagraphs",
          "contactTitle",
          "contactNote",
          "contactEmail",
          "updatedAt"
        ])
        && data.locale == locale
        && data.heroKicker is string
        && data.heroKicker.size() > 0
        && data.heroKicker.size() <= 160
        && data.heroName is string
        && data.heroName.size() > 0
        && data.heroName.size() <= 160
        && data.heroIntro is string
        && data.heroIntro.size() > 0
        && data.heroIntro.size() <= 2000
        && data.aboutTitle is string
        && data.aboutTitle.size() > 0
        && data.aboutTitle.size() <= 300
        && hasValidAboutParagraphs(data.aboutParagraphs)
        && data.contactTitle is string
        && data.contactTitle.size() > 0
        && data.contactTitle.size() <= 300
        && data.contactNote is string
        && data.contactNote.size() <= 1000
        && data.contactEmail is string
        && data.contactEmail.size() > 3
        && data.contactEmail.size() <= 320
        && data.updatedAt is timestamp;
    }

    function hasValidAboutParagraphs(paragraphs) {
      return paragraphs is list
        && paragraphs.size() > 0
        && paragraphs.size() <= 10
        && paragraphs[0] is string
        && paragraphs[0].size() > 0
        && (paragraphs.size() < 2 || (paragraphs[1] is string && paragraphs[1].size() > 0))
        && (paragraphs.size() < 3 || (paragraphs[2] is string && paragraphs[2].size() > 0))
        && (paragraphs.size() < 4 || (paragraphs[3] is string && paragraphs[3].size() > 0))
        && (paragraphs.size() < 5 || (paragraphs[4] is string && paragraphs[4].size() > 0))
        && (paragraphs.size() < 6 || (paragraphs[5] is string && paragraphs[5].size() > 0))
        && (paragraphs.size() < 7 || (paragraphs[6] is string && paragraphs[6].size() > 0))
        && (paragraphs.size() < 8 || (paragraphs[7] is string && paragraphs[7].size() > 0))
        && (paragraphs.size() < 9 || (paragraphs[8] is string && paragraphs[8].size() > 0))
        && (paragraphs.size() < 10 || (paragraphs[9] is string && paragraphs[9].size() > 0));
    }

    function hasValidProjectShape(projectId, data) {
      return data.keys().hasAll([
          "locale",
          "title",
          "slug",
          "excerpt",
          "content",
          "order",
          "category",
          "status",
          "year",
          "role",
          "stack",
          "published",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "locale",
          "title",
          "slug",
          "excerpt",
          "content",
          "order",
          "category",
          "status",
          "year",
          "role",
          "stack",
          "published",
          "createdAt",
          "updatedAt"
        ])
        && data.locale in ["zh", "en", "ja"]
        && projectId == data.locale + "--" + data.slug
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.slug is string
        && data.slug.size() > 0
        && data.slug.size() <= 120
        && data.slug.matches("^[a-z0-9]+(?:-[a-z0-9]+)*$")
        && data.excerpt is string
        && data.excerpt.size() <= 1000
        && data.content is string
        && data.content.size() <= 300000
        && data.order is int
        && data.order >= 0
        && data.order <= 10000
        && data.category is string
        && data.category.size() <= 120
        && data.status is string
        && data.status.size() <= 80
        && data.year is string
        && data.year.size() <= 40
        && data.role is string
        && data.role.size() <= 160
        && data.stack is list
        && data.stack.size() <= 30
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if isAdmin() || resource.data.status == "published";

      allow create: if isAdmin()
        && hasValidPostShape(request.resource.data)
        && hasValidCreateTimes(request.resource.data)
        && slugPointsToPost(postId, request.resource.data.slug);

      allow update: if isAdmin()
        && hasValidPostShape(request.resource.data)
        && hasValidUpdateTimes(resource.data, request.resource.data)
        && slugPointsToPost(postId, request.resource.data.slug);

      allow delete: if isAdmin();
    }

    match /postSlugs/{slug} {
      allow read: if isAdmin()
        || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.status == "published";

      allow create, update: if isAdmin()
        && validSlugReservation(slug, request.resource.data);

      allow delete: if isAdmin();
    }

    match /siteContent/{locale} {
      allow read: if locale in ["zh", "en", "ja"];

      allow create, update: if isAdmin()
        && hasValidSiteContentShape(locale, request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.published == true;

      allow create: if isAdmin()
        && hasValidProjectShape(projectId, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && hasValidProjectShape(projectId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }
  }
}
