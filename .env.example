# Firebase Web App configuration (Firebase Console > Project settings > Your apps).
# These values are embedded in the public browser bundle; do not put service-account
# keys or other server credentials here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# The Firebase Authentication UID of the single administrator.
# After setting this in .env.local, run: npm run firebase:set-admin
FIREBASE_ADMIN_UID=
